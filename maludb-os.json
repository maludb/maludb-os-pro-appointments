{
  "schema": "maludb-os.application/1",
  "catalog_key": "pro_appointments",
  "name": "Pro Appointments",
  "description": "Appointment scheduling for professional services: services, availability and time off, clients, appointments and the calendar, the public booking page, and the voice, SMS and email scheduling agents — one installation for every business of the company, each business a site.",
  "business_area": "Sales & Service",
  "category": "calendar",
  "icon": "feather-calendar",
  "version": "1.0.0",
  "criticality": "normal",
  "vhost": {
    "label": "appointments",
    "document_root": "html",
    "internal_port_env": "APP_INTERNAL_PORT"
  },
  "database": {
    "suffix": "pro_appointments",
    "migrations": "db",
    "roles": {
      "rw": "pro_appointments_rw",
      "records_ro": "pro_appointments_records_ro",
      "activity_ro": "pro_appointments_activity_ro"
    }
  },
  "env": {
    "required": [
      "APP_NAME",
      "APP_URL",
      "APP_KEY",
      "DB_HOST",
      "DB_PORT",
      "DB_NAME",
      "DB_USER",
      "DB_PASSWORD",
      "APP_INTERNAL_PORT",
      "ACTION_TOKEN_KEY",
      "OS_ENABLED",
      "OS_APPLICATION_TOKEN",
      "OS_INTERNAL_URL",
      "OS_LAUNCHER_URL"
    ],
    "optional": [
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET",
      "RETELL_DEFAULT_API_KEY",
      "EMAIL_WEBHOOK_SECRET",
      "DEMO_ENABLED"
    ]
  },
  "services": [
    "deploy/pro_appointments-directory-sync.service",
    "deploy/pro_appointments-directory-sync.timer",
    "deploy/pro_appointments-reminders.service",
    "deploy/pro_appointments-reminders.timer",
    "deploy/pro_appointments-voice-messages.service",
    "deploy/pro_appointments-voice-messages.timer"
  ],
  "endpoints": [
    {
      "name": "Kernel MCP",
      "kind": "mcp",
      "path": "/api/mcp/kernel.php",
      "auth_kind": "bearer",
      "agent_reachable": false,
      "mcp_surface_version": "1.0"
    },
    {
      "name": "Web UI",
      "kind": "ui",
      "path": "/app.php",
      "auth_kind": "none",
      "agent_reachable": false
    },
    {
      "name": "Health",
      "kind": "http_api",
      "path": "/api/v1/health",
      "auth_kind": "none",
      "agent_reachable": false
    },
    {
      "name": "REST API",
      "kind": "http_api",
      "path": "/api/v1/",
      "auth_kind": "bearer",
      "agent_reachable": false
    }
  ],
  "sso": {
    "path": "/sso",
    "logout_path": "/sso/logout"
  },
  "directory": {
    "reads": true,
    "writes": false
  },
  "scopes": {
    "kind": "location"
  },
  "identity": {
    "profile": "adopted",
    "enabled_env": "OS_ENABLED"
  }
}
